{
  "name": "client-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run prune",
    "preview": "vite preview",
    "test": "vitest run --reporter=verbose",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prune": "find dist -name '*.map' -delete && [ -f dist/sw.js ] && printf '\n// __WB_MANIFEST\n' >> dist/sw.js",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/logo.svg",
    "test:ci": "vitest run --reporter=verbose",
    "cap:copy": "cap copy",
    "cap:sync": "cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "assets:generate": "capacitor-assets generate"
  },
  "engines": {
    "node": ">=20.10 <23"
  },
  "dependencies": {
    "@boreal/shared-contract": "file:../shared-contract",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/preferences": "^8.0.1",
    "@tanstack/react-query": "^5.56.20",
    "@twilio/voice-sdk": "^2.18.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.0",
    "jwt-decode": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "uuid": "^11.1.0",
    "zod": "^3.23.8",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/app-launcher": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/device": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.27",
    "depcheck": "^1.4.7",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "html2canvas": "^1.4.1",
    "jsdom": "^24.0.0",
    "lodash.debounce": "^4.0.8",
    "madge": "^8.0.0",
    "npm-check-updates": "^17.1.12",
    "postcss": "^8.5.8",
    "semver": "^7.6.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.46.2",
    "vite": "^4.5.14",
    "vite-plugin-pwa": "^0.20.0",
    "vite-tsconfig-paths": "file:../vite-tsconfig-paths-shim",
    "vitest": "^2.1.1",
    "@capacitor/assets": "^3.0.5"
  },
  "engineStrict": true
}
